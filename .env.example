# Copy to .env.local for local overrides. Never commit real secrets.

# Public base URL used for canonical links, Open Graph, sitemap.xml, robots.txt and JSON-LD.
# Default: https://aracpolywrap.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Disable Next.js anonymous telemetry (optional).
NEXT_TELEMETRY_DISABLED=1
