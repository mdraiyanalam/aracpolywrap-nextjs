# Copy to .env.local for local overrides. Never commit real secrets.

# Public base URL used for canonical links, Open Graph, sitemap.xml, robots.txt and JSON-LD.
# Default: https://aracpolywrap.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Static export only (npm run build:static): sub-path of a GitHub Pages project site, e.g.
# /aracpolywrap for https://<user>.github.io/aracpolywrap/. Leave empty for a domain root.
# The GitHub Pages workflow sets this automatically.
# NEXT_PUBLIC_BASE_PATH=/aracpolywrap

# Disable Next.js anonymous telemetry (optional).
NEXT_TELEMETRY_DISABLED=1
