{
  "name": "aracpolywrap",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website for ARAC Polywrap Limited — manufacturer of stretch, shrink, lamination, agricultural, protection and custom polyethylene films.",
  "author": "Md Raiyan Alam (https://www.linkedin.com/in/mdraiyanalam/)",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdraiyanalam/aracpolywrap.git"
  },
  "bugs": {
    "url": "https://github.com/mdraiyanalam/aracpolywrap/issues"
  },
  "homepage": "https://github.com/mdraiyanalam/aracpolywrap#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:static": "node scripts/e2e-static.mjs",
    "validate": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "prepare": "husky",
    "content:check": "node scripts/check-content.mjs",
    "docker:build": "docker build -t aracpolywrap:local .",
    "docker:run": "docker run --rm -p 3000:3000 aracpolywrap:local"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
